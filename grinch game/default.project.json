{
  "name": "StealChristmas",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": { "$path": "src/shared" }
    },
    "ServerScriptService": {
      "Server": { "$path": "src/server" }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": { "$path": "src/client" }
      }
    },
    "Players": {
      "$properties": { "CharacterAutoLoads": false }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": true,
        "StreamingTargetRadius": 768,
        "StreamingMinRadius": 256
      }
    },
    "SoundService": {
      "$properties": { "RespectFilteringEnabled": true }
    }
  }
}
